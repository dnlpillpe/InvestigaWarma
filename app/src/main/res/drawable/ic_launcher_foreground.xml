<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono InvestigaWarma: "el pequeño detective". Cabeza del niño explorador con
  su sombrero y su lupa, en vez de solo un símbolo abstracto de lupa.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Mechones de cabello a los lados -->
    <path android:fillColor="#2E1A47" android:pathData="M38,52 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
    <path android:fillColor="#2E1A47" android:pathData="M70,52 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- Cabeza -->
    <path android:fillColor="#F3C7A0" android:pathData="M54,60 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0" />

    <!-- Ala del sombrero -->
    <path android:fillColor="#B8763A" android:pathData="M54,47 m-20,0 a20,6 0 1,0 40,0 a20,6 0 1,0 -40,0" />

    <!-- Copa del sombrero -->
    <path android:fillColor="#C17F45" android:pathData="M54,39 m-13,0 a13,11 0 1,0 26,0 a13,11 0 1,0 -26,0" />

    <!-- Cinta del sombrero -->
    <path android:fillColor="#8A5A2B" android:pathData="M54,45 m-13,0 a13,2.5 0 1,0 26,0 a13,2.5 0 1,0 -26,0" />

    <!-- Ojos -->
    <path android:fillColor="#2E1A47" android:pathData="M49,59 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
    <path android:fillColor="#2E1A47" android:pathData="M59,59 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />

    <!-- Sonrisa -->
    <path
        android:strokeColor="#2E1A47"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M48,66 Q54,70 60,66" />

    <!-- Mango de la lupa -->
    <path
        android:strokeColor="#FFB020"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M80,76 L87,83" />

    <!-- Aro de la lupa -->
    <path
        android:strokeColor="#20D3C2"
        android:strokeWidth="4.5"
        android:pathData="M72,68 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0" />

    <!-- Cristal de la lupa -->
    <path android:fillColor="#0F1B3C" android:fillAlpha="0.5" android:pathData="M72,68 m-9.5,0 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0" />

    <!-- Destello de descubrimiento en el cristal -->
    <path android:fillColor="#FFFFFF" android:pathData="M72,61 L73.6,66.4 L79,68 L73.6,69.6 L72,75 L70.4,69.6 L65,68 L70.4,66.4 Z" />
</vector>
