    <!-- Onboarding -->
    <string name="onboarding_title_1">Bienvenido a la Academia</string>
    <string name="onboarding_body_1">InvestigaWarma es una academia científica donde tú eres el investigador. Explora zonas, resuelve misiones y construye tu propio museo de descubrimientos.</string>
    <string name="onboarding_title_2">Conoce a IRIS</string>
    <string name="onboarding_body_2">IRIS es tu guía. Te acompaña en cada misión, celebra tus avances y te da pistas cuando las necesitas.</string>
    <string name="onboarding_title_3">Piensa como científico</string>
    <string name="onboarding_body_3">Observa, pregunta, crea hipótesis, experimenta y descubre. Cada misión sigue el método científico, paso a paso.</string>
    <string name="onboarding_title_4">Tus datos, tu privacidad</string>
    <string name="onboarding_body_4">No necesitas nombre real ni internet. Elige un alias y un avatar. Todo tu progreso se guarda solo en este dispositivo.</string>
    <string name="onboarding_cta_next">Siguiente</string>
    <string name="onboarding_cta_start">Comenzar</string>

